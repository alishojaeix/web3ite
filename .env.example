# Copy to .env.local and adjust. Never commit real credentials.

# Required for accounts in production. At least 32 characters.
# AUTH_SECRET=replace-with-a-long-random-string-at-least-32-chars

# Writable directory for the JSON store. Serverless deployments need a mounted
# volume or a database instead.
# WEB3ITE_DATA_DIR=./data/runtime

# Canonical origin used for Stripe redirect URLs.
# NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: enables Stripe Checkout and webhook verification.
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...

# Optional: forward template contact forms to this endpoint instead of the
# local JSON inbox.
# SITE_INBOX_WEBHOOK_URL=https://example.com/inbox
